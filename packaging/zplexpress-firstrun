#!/bin/sh
# First-run helper: opens the setup dashboard automatically, but only until a
# printer has been configured. Runs from the desktop autostart hook and, best
# effort, right after install.
CFG="${ZPL_CONFIG:-/etc/zplexpress/config.json}"

# If a printer is already configured, there's nothing to set up — stay quiet.
if [ -f "$CFG" ] && grep -q '"printerName"[[:space:]]*:[[:space:]]*"[^"]\{1,\}"' "$CFG"; then
  exit 0
fi

# Wait (up to ~20s) for the service to be listening, so the browser lands on the
# dashboard rather than a connection-refused page. nodejs is a package dependency.
node -e '
const net=require("net"), fs=require("fs");
const cfg=process.argv[1];
function port(){try{const m=fs.readFileSync(cfg,"utf8").match(/"port"\s*:\s*(\d+)/);return m?+m[1]:3000;}catch(e){return 3000;}}
let n=0;
(function tick(){
  const s=net.connect(port(),"127.0.0.1");
  s.on("connect",()=>{s.end();process.exit(0);});
  s.on("error",()=>{s.destroy();if(++n>40)process.exit(1);setTimeout(tick,500);});
})();
' "$CFG" || exit 0

exec zplexpress-open
